---
/**
 * Pré-carrega os pesos mais usados do Geist Sans e Geist Mono.
 *
 * O font-display: optional (aplicado pelo plugin Vite em astro.config.mjs)
 * faz com que o browser use a fonte do cache imediatamente — sem swap.
 * Os preloads aqui garantem que os pesos críticos estejam disponíveis
 * antes da primeira aplicação de CSS, eliminando o FOUC na primeira visita.
 */
import Default from "@astrojs/starlight/components/Head.astro";

// Vite processa esses imports com ?url e retorna as URLs com hash de produção.
import gs400 from "@fontsource/geist-sans/files/geist-sans-latin-400-normal.woff2?url";
import gs700 from "@fontsource/geist-sans/files/geist-sans-latin-700-normal.woff2?url";
import gm400 from "@fontsource/geist-mono/files/geist-mono-latin-400-normal.woff2?url";
---

<Default><slot /></Default>
<link rel="preload" href={gs400} as="font" type="font/woff2" crossorigin="" />
<link rel="preload" href={gs700} as="font" type="font/woff2" crossorigin="" />
<link rel="preload" href={gm400} as="font" type="font/woff2" crossorigin="" />

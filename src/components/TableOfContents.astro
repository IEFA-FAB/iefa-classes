---
// Compõe o TableOfContents do theme-black (TOC customizado com JS próprio)
// com o switcher de modo do starlight-view-modes na barra lateral direita.
// O plugin não conseguia registrar seu TableOfContents porque o theme-black
// já havia tomado o slot.
import ThemeBlackTableOfContents from "starlight-theme-black/overrides/TableOfContents.astro";
import ViewModeSwitcher from "starlight-view-modes/components/ViewModeSwitcher.astro";
---

<ThemeBlackTableOfContents />
<ViewModeSwitcher type="table-of-contents" />
